; Showcase project for the SCFG Godot addon: one screen that exercises the whole public API.
; Run `uv run python tools/sync_demo.py --engine godot` first: it copies godot/addons/scfg/ into
; this project's addons/ folder (and into the demo's).

config_version=5

[application]

config/name="SCFG Showcase"
config/description="A tour of the Stablecoin for Games addon on testnets: unlocks, tips, restore and receipts."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Scfg="*res://addons/scfg/scfg.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/scfg/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[debug]

; This project's own scripts must be typed: an untyped declaration is an error, an unsafe cast a
; warning in the editor. The addon under addons/ is checked in the dev project (godot/).
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_cast=1

; Minimal dev project for the SCFG Godot addon (addons/scfg: the core and the glue) and its headless tests.

config_version=5

[application]

config/name="scfg-dev"
config/features=PackedStringArray("4.3")

[autoload]

Scfg="*res://addons/scfg/scfg.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/scfg/plugin.cfg")
